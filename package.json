{
  "name": "cordova-plugin-boogie-insomnia",
  "version": "1.0.0",
  "description": "Keep the device screen awake from JavaScript (Android, iOS, browser). Promise-based fork of @globules-io/cordova-plugin-insomnia that re-asserts the keep-awake after camera/picker interruptions. JS global: boogieInsomnia.",
  "cordova": {
    "id": "cordova-plugin-boogie-insomnia",
    "platforms": [
      "android",
      "ios",
      "browser"
    ]
  },
  "types": "./index.d.ts",
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boogie/cordova-plugin-boogie-insomnia.git"
  },
  "bugs": {
    "url": "https://github.com/boogie/cordova-plugin-boogie-insomnia/issues"
  },
  "homepage": "https://github.com/boogie/cordova-plugin-boogie-insomnia#readme",
  "keywords": [
    "insomnia",
    "screen",
    "awake",
    "wakelock",
    "keep-screen-on",
    "sleep",
    "ecosystem:cordova",
    "cordova-android",
    "cordova-ios",
    "cordova-browser"
  ],
  "engines": [
    {
      "name": "cordova",
      "version": ">=9.0.0"
    }
  ],
  "author": "András Bártházi",
  "license": "MIT"
}
